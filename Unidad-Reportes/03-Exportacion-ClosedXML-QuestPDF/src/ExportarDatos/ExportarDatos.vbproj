<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExportarDatos</RootNamespace>
    <!-- Punto de entrada explícito (Program.vb), igual que en los temas anteriores -->
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>ExportarDatos.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <!-- Espacios de nombres importados en todos los archivos (igual que la plantilla de VS) -->
  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmExportar.vb">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <!-- El logo se usa en el Excel y en el PDF: se copia a bin\...\Recursos -->
  <ItemGroup>
    <None Update="Recursos\logo-uni.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReporteRDLC</RootNamespace>
    <!-- Punto de entrada explícito (Program.vb), igual que en los temas anteriores -->
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>ReporteRDLC.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <!-- Espacios de nombres importados en todos los archivos (igual que la plantilla de VS) -->
  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="ReportViewerCore.WinForms" Version="15.1.33" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmReporte.vb">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <!-- El .rdlc se lee desde disco: se copia a bin\...\Reportes en cada compilación -->
  <ItemGroup>
    <None Update="Reportes\RptAlumnos.rdlc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReporteImpresion</RootNamespace>
    <!-- Punto de entrada explícito (Program.vb), igual que en GestionAlumnos -->
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>ReporteImpresion.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <!-- Espacios de nombres importados en todos los archivos (igual que la plantilla de VS) -->
  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmReporte.vb">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <!-- Copia los logos a la carpeta de salida (bin\...\Recursos) -->
  <ItemGroup>
    <None Update="Recursos\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
